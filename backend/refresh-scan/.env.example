# Refresh-scan backend: NAMES ONLY. Never put real values in this file or commit a filled-in copy.
# Set these in the hosting platform's secret store (or a local, git-ignored .env while experimenting).

# owner/name of the catalog repository (not a secret)
GITHUB_REPOSITORY=PPYGaming/Tamil-anime

# Fine-grained personal access token, restricted to that ONE repository, permission "Actions: Read and write" only.
GITHUB_DISPATCH_TOKEN=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Callback URL = PUBLIC_BASE_URL + /auth/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 32+ random characters, e.g. the output of: openssl rand -base64 48
SESSION_SECRET=

# Comma separated GitHub logins allowed to start a scan, and (recommended) their numeric account ids.
OWNER_GITHUB_LOGINS=
OWNER_GITHUB_USER_IDS=

# The exact origin of the published site (no path, no trailing slash, no wildcard), e.g. https://<user>.github.io
ALLOWED_ORIGIN=

# The public https URL of THIS service, once it exists. Leave empty until a host has been chosen and deployed.
PUBLIC_BASE_URL=

# Optional, shown with their defaults
# WORKFLOW_FILE=update-anime.yml
# WORKFLOW_REF=main
# BASE_PATH=
# SESSION_TTL_SECONDS=1800
# SCAN_WAIT_TIMEOUT_MS=1500000
# DISPATCH_COOLDOWN_SECONDS=60
# MAX_DISPATCHES_PER_HOUR=6
# STATUS_POLLS_PER_10_MIN=200
# AUTH_ATTEMPTS_PER_10_MIN=30
# TRUST_PROXY=false
