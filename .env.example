# Names only. Real values belong in GitHub Actions secrets (or a local, git-ignored .env), never in this file.
TMDB_API_KEY=
YOUTUBE_API_KEY=
CONTENT_REGION=IN
UPDATE_CRON=0 */6 * * *
UPDATE_ON_START=true
YOUTUBE_MAX_RESULTS=10

# Automatic discovery from the allow-listed official YouTube channel (off unless true).
# The channel allow-list is data/official-tamil-dub-manifest.json -> officialYouTubeChannels
# (and/or OFFICIAL_YOUTUBE_CHANNEL_IDS, comma separated). Needs YOUTUBE_API_KEY.
DISCOVERY_ENABLED=false
# Where the resumable scan checkpoint is kept (public-safe: ids, page cursors, review queue; no keys).
DISCOVERY_STATE_FILE=data/discovery-state.json

# Optional tuning, shown with defaults
# DISCOVERY_BOOTSTRAP_PAGES=100        history pages walked per run (50 videos per page; 2 quota units per page)
# DISCOVERY_INCREMENTAL_PAGES=10       newest pages re-read every run
# DISCOVERY_OVERLAP_HOURS=72           re-read this far behind the last seen upload, to catch late additions
# DISCOVERY_UNIT_BUDGET=2000           hard cap on YouTube quota units per run (default project quota: 10000/day)
# DISCOVERY_MIN_EPISODE_SECONDS=600    shorter videos are reviewed as possible clips
# DISCOVERY_QUEUE_RETRY_LIMIT=100
# DISCOVERY_RECHECK_LIMIT=150          already-added videos re-checked per run for deletion/privacy/region changes
# DISCOVERY_UNAVAILABLE_RETRY_DAYS=30
# DISCOVERY_FULL_RESCAN=false
# DISCOVERY_TIMEOUT_MS=20000
# DISCOVERY_RETRIES=3
# DISCOVERY_BACKOFF_BASE_MS=500
# DISCOVERY_BACKOFF_MAX_MS=15000
